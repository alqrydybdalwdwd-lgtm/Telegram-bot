from telegram.ext import ApplicationBuilder, CommandHandler, MessageHandler, filters, ContextTypes

TOKEN = "8952440627:AAE-D2e2pq9Vw-x_Os9RUGBd8UbjzcRD_V0"

# --- أوامر أساسية ---
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    chat_type = update.effective_chat.type
    if chat_type == "private":
        await update.message.reply_text("أهلاً بك! أرسل هذا البوت إلى مجموعتك 😎")
    else:
        await update.message.reply_text("👋 مرحباً بالمجموعة! البوت الآن يعمل هنا.")

async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "الأوامر المتاحة:\n"
        "/start - بدء البوت\n"
        "/help - المساعدة\n"
        "/info - معلومات عن البوت\n"
        "/protect - حماية البوت (تجريبي)\n"
        "البوت يرد تلقائياً على الرسائل الشائعة في المجموعة."
    )

async def info(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "بوت شبيه Group Help للمجموعات على Telegram\n"
        "تم إنشاؤه بواسطة عبدالوُدود 🔐"
    )

async def protect(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("🔒 هذا أمر حماية تجريبي. البوت يعمل لجميع المستخدمين!")

# --- رد تلقائي على رسائل معينة ---
async def auto_reply(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = update.message.text.lower()
    if "السلام عليكم" in text:
        await update.message.reply_text("وعليكم السلام ورحمة الله وبركاته 🌹")
    elif "مرحبا" in text or "هلا" in text:
        await update.message.reply_text("أهلاً! 👋 كيف حالكم؟")
    elif "مساعدة" in text:
        await update.message.reply_text("للمساعدة استخدم الأمر /help")

# --- إعداد البوت ---
app = ApplicationBuilder().token(TOKEN).build()

# إضافة الأوامر
app.add_handler(CommandHandler("start", start))
app.add_handler(CommandHandler("help", help_command))
app.add_handler(CommandHandler("info", info))
app.add_handler(CommandHandler("protect", protect))

# إضافة الرد التلقائي على أي رسالة نصية
app.add_handler(MessageHandler(filters.TEXT & (~filters.COMMAND), auto_reply))

# تشغيل البوت
app.run_polling()

